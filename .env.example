# Jira Cloud REST API v3
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your-jira-api-token

# Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash

# --- Sign-in & access ---
# Signs session cookies. Required on Vercel (generate: openssl rand -hex 32). Auto-generated locally.
SESSION_SECRET=
# Always admins. Comma-separated.
ADMIN_EMAILS=you@yourcompany.com
# Anyone with these email domains can join as a member on first sign-in. Others need an invite.
ALLOWED_EMAIL_DOMAINS=yourcompany.com

# --- Email (sign-in codes + invites). Pick ONE free provider. Unset locally = codes print to the server console.
# Brevo: 300/day free, verify a single sender address (no DNS needed). https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
# Resend: 3,000/month free, requires verifying your domain's DNS. https://resend.com/api-keys
RESEND_API_KEY=
EMAIL_FROM=PM Agent <no-reply@yourcompany.com>

# --- "Continue with Google / Microsoft" (optional, free). A button appears only when its vars are set.
# Redirect URI to register: https://<your-site>/api/auth/sso/google/callback (and .../microsoft/callback)
# Google: console.cloud.google.com → APIs & Services → Credentials → OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft: entra.microsoft.com → App registrations → New (single tenant) → Certificates & secrets
# TENANT_ID must be the "Directory (tenant) ID" GUID, not a domain name.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
